# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# Only `npm run bench:agent` reads this; every other command — including `npm run check` —
# runs offline and needs nothing here.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Ceiling per cell, in US dollars. The runner refuses to start without one.
TREADLE_BENCH_BUDGET_USD=1.50
