# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# Only `npm run bench:agent` reads this; every other command — including `npm run check` —
# runs offline and needs nothing here.

# https://console.anthropic.com/settings/keys
#
# Use a key created for this project, not a shared or employer one. Usage is attributable per
# key — an org admin can read tokens, model and cost per api_key_id — and a key shared across
# projects blends their traffic, which also makes the bench's own per-stratum cost unreadable.
ANTHROPIC_API_KEY=sk-ant-...

# Ceiling per cell, in US dollars. The runner refuses to start without one.
TREADLE_BENCH_BUDGET_USD=1.50
