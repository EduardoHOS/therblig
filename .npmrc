# Refuse to install under a runtime that does not satisfy package.json "engines".
# Declared, not assumed: the machine that produced F1-F9 was running Node 20.10,
# where bpmnlint's CJS require() of ESM-only min-dash throws ERR_REQUIRE_ESM and
# require(esm) behaves differently. An outside reproducer must fail loudly rather
# than silently measure something else. See ADR-007.
engine-strict=true

# Exact versions in package.json; the lockfile is the record.
save-exact=true
