# Dependencies
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Benchmark output — regenerate with `npm run bench`, never commit
bench/results/
*.bpmn.rt
*.bpmn.out

# Local toolchain pins (machine-specific paths)
.node22path
.nvmrc.local

# Scratch and research material fetched during development
reference/
scratch/
tmp/

# Logs and diagnostics
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
coverage/

# Next.js build output for the Studio; the app is source, the build is not.
.next/
.next-build/
next-env.d.ts
.nyc_output/

# Environment and secrets. `.env` holds a real API key: `npm run bench:agent` is the only
# thing that reads it, and nothing else in this repository needs it.
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# AI assistant local state — never published
.claude/
.cursor/
.serena/
.aider*
CLAUDE.local.md

# emitted from JSDoc by `npm run types`; never hand-edited
types/
