{
  "name": "therblig-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness for therblig: does a structured patch API make an LLM more correct at editing BPMN than editing the XML directly?",
  "license": "Apache-2.0",
  "homepage": "https://github.com/EduardoHOS/therblig#readme",
  "bugs": "https://github.com/EduardoHOS/therblig/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoHOS/therblig.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node bench/arms/ir-selftest.mjs && node bench/arms/place-selftest.mjs && node bench/probe/probe-labels.mjs && node bench/probe/probe-invariants.mjs",
    "bench:profile": "node bench/corpus/profile.mjs bench/corpus",
    "bench:diff-floor": "node bench/corpus/probe-diff-floor.mjs bench/corpus",
    "bench:layout": "node bench/scorer/probe-layout.mjs bench/corpus",
    "bench:baseline": "node bench/scorer/baseline.mjs bench/corpus",
    "bench:roundtrip": "node bench/scorer/probe-roundtrip.mjs bench/corpus/handmade/zeebe-roundtrip.bpmn",
    "inventory": "node bench/tasks/inventory.mjs bench/corpus",
    "probe": "node bench/probe/probe-conserve.mjs bench/corpus",
    "probe:labels": "node bench/probe/probe-labels.mjs",
    "probe:invariants": "node bench/probe/probe-invariants.mjs",
    "probe:conserve": "node bench/probe/probe-conserve.mjs bench/corpus",
    "licence-guard": "node scripts/licence-guard.mjs",
    "probe:mcp-era": "node bench/probe/mcp-era/drive.mjs",
    "probe:comment-incidence": "node bench/probe/probe-comment-incidence.mjs 220"
  },
  "dependencies": {
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "^11.13.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  }
}
