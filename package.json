{
  "name": "treadle-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness for Treadle: does a structured patch API make an LLM more correct at editing BPMN than editing the XML directly?",
  "license": "Apache-2.0",
  "homepage": "https://github.com/EduardoHOS/treadle#readme",
  "bugs": "https://github.com/EduardoHOS/treadle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoHOS/treadle.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --import-plugin --node-plugin backend bench",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=backend/core/**/*.mjs --test-coverage-include=backend/io/**/*.mjs --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "corpus": "node bench/scorer/baseline.mjs bench/corpus",
    "check": "npm run lint && npm run types && npm run test:coverage && npm run corpus",
    "bench:profile": "node bench/corpus/profile.mjs bench/corpus",
    "bench:diff-floor": "node bench/corpus/probe-diff-floor.mjs bench/corpus",
    "bench:layout": "node bench/scorer/probe-layout.mjs bench/corpus",
    "bench:baseline": "node bench/scorer/baseline.mjs bench/corpus",
    "bench:roundtrip": "node bench/scorer/probe-roundtrip.mjs bench/corpus/handmade/zeebe-roundtrip.bpmn",
    "inventory": "node bench/tasks/inventory.mjs bench/corpus",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.consumer.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "^11.13.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "bin": {
    "treadle": "backend/cli/main.mjs",
    "treadle-mcp": "backend/mcp/server.mjs"
  },
  "types": "types/core/index.d.mts"
}
