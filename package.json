{
  "name": "treadle-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness for Treadle: does a structured patch API make an LLM more correct at editing BPMN than editing the XML directly?",
  "license": "Apache-2.0",
  "homepage": "https://github.com/EduardoHOS/treadle#readme",
  "bugs": "https://github.com/EduardoHOS/treadle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoHOS/treadle.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --import-plugin --node-plugin backend bench",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=backend/core/**/*.mjs --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "corpus": "node bench/scorer/baseline.mjs bench/corpus",
    "check": "npm run lint && npm run test:coverage && npm run corpus",
    "bench:profile": "node bench/corpus/profile.mjs bench/corpus",
    "bench:diff-floor": "node bench/corpus/probe-diff-floor.mjs bench/corpus",
    "bench:layout": "node bench/scorer/probe-layout.mjs bench/corpus",
    "bench:baseline": "node bench/scorer/baseline.mjs bench/corpus",
    "bench:roundtrip": "node bench/scorer/probe-roundtrip.mjs bench/corpus/handmade/zeebe-roundtrip.bpmn",
    "inventory": "node bench/tasks/inventory.mjs bench/corpus",
    "oracle": "node backend/cli/bin.mjs lint bench/corpus",
    "verify:corpus": "node bench/corpus-sweep.mjs bench/corpus",
    "probe": "node bench/probe/probe-conserve.mjs bench/corpus",
    "probe:comment-incidence": "node bench/probe/probe-comment-incidence.mjs 220",
    "licence-guard": "node scripts/licence-guard.mjs",
    "therblig": "node backend/cli/bin.mjs",
    "probe:labels": "node bench/probe/probe-labels.mjs",
    "probe:invariants": "node bench/probe/probe-invariants.mjs"
  },
  "dependencies": {
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "^11.13.0",
    "xmllint-wasm": "^5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "oxlint": "1.81.0"
  }
}
