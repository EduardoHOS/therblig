{
  "name": "therblig",
  "version": "0.1.0",
  "private": false,
  "description": "Read, explain, lint and edit the .bpmn files already in your repo, without wrecking the diagram.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./model": "./src/model.mjs",
    "./ir": "./src/ir.mjs",
    "./patch": "./src/patch.mjs",
    "./place": "./src/place.mjs",
    "./mcp": "./src/mcp/server.mjs",
    "./oracle": "./src/oracle/inspect.mjs",
    "./mcp/bin": "./src/mcp/bin.mjs",
    "./receipt": "./src/receipt.mjs",
    "./render": "./src/render/svg.mjs",
    "./diff": "./src/diff.mjs"
  },
  "files": [
    "src",
    "third_party",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "bpmn-moddle": "^10.2.0",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.2.0"
  },
  "bin": {
